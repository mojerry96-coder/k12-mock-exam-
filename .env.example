# Copy to .env.local. These stay on the server and never reach the browser bundle.

# Handwriting recognition (Mathpix strokes API). With keys, pen mode uses Mathpix and falls back to the
# built-in on-device recogniser if Mathpix can't be reached. Without keys, every device uses the
# on-device recogniser.
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# "queued" keeps results pending after completion until marking is released.
MARKING=
# Extra time for every question (1–3). A stand-in for per-learner accommodations from the host.
TIME_MULTIPLIER=
